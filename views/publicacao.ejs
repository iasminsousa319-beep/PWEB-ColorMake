
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Publicação | ColorMake</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <header>
        <h1>ColorMake</h1>

        <nav>
            <a href="/">Início</a>
            <a href="/comunidade">Comunidade</a>

            <% if (usuario) { %>
                <span>Olá, <%= usuario.nome %>!</span>
                <form action="/logout" method="POST">
                    <button type="submit">Sair</button>
                </form>
            <% } else { %>
                <a href="/login">Entrar</a>
                <a href="/cadastro">Cadastrar</a>
            <% } %>
        </nav>
    </header>

    <main class="publication-page">

        <article class="post-card">

            <h2><%= publicacao.nomeUsuario %></h2>

            <img
                src="<%= publicacao.imagem %>"
                alt="Maquiagem publicada"
            >

            <p><%= publicacao.legenda %></p>

            <small>
                <%= new Date(publicacao.dataCriacao).toLocaleDateString("pt-BR") %>
            </small>

        </article>

        <section class="comments-section">

            <h2>Comentários e dicas</h2>

            <p>
                Gostou da maquiagem? Compartilhe uma dica,
                sugestão ou opinião!
            </p>

            <% if (usuario) { %>

                <form action="/publicacoes/<%= publicacao._id %>/comentarios"
                      method="POST"
                      class="post-form">

                    <label for="texto">Seu comentário</label>

                    <textarea
                        id="texto"
                        name="texto"
                        maxlength="500"
                        required
                        placeholder="Deixe sua dica ou opinião..."
                    ></textarea>

                    <button type="submit">Enviar comentário</button>

                </form>

            <% } else { %>

                <p>
                    Para comentar, faça
                    <a href="/login">login</a>
                    ou <a href="/cadastro">crie sua conta</a>.
                </p>

            <% } %>

            <h3>O que estão dizendo</h3>

            <% if (comentarios.length > 0) { %>

                <% comentarios.forEach(comentario => { %>

                    <div class="comment-card">

                        <strong><%= comentario.nomeUsuario %></strong>

                        <p><%= comentario.texto %></p>

                        <small>
                            <%= new Date(comentario.dataCriacao).toLocaleDateString("pt-BR") %>
                        </small>

                    </div>

                <% }) %>

            <% } else { %>

                <p>Seja a primeira pessoa a comentar!</p>

            <% } %>

        </section>

    </main>

</body>
</html>
