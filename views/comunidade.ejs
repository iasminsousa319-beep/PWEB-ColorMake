<% if (usuario) { %>

    <form action="/publicacoes"
          method="POST"
          enctype="multipart/form-data"
          class="post-form">

        <label for="legenda">Conte sobre sua maquiagem</label>

        <textarea
            id="legenda"
            name="legenda"
            maxlength="500"
            required
            placeholder="Quais produtos usou? Tem alguma dúvida?"
        ></textarea>

        <label for="foto">Escolha sua foto</label>

        <input
            type="file"
            id="foto"
            name="foto"
            accept="image/jpeg,image/png,image/webp"
            required
        >

        <button type="submit">Publicar maquiagem</button>

    </form>

<% } else { %>

    <p>
        Para publicar sua maquiagem,
        <a href="/login">entre na sua conta</a>
        ou <a href="/cadastro">cadastre-se</a>.
    </p>

<% } %>